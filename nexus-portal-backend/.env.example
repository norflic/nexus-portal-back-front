# General

## Running options
SERVER_PORT=3001
BUILD_TARGET= 'start' | 'watch' | 'test'
#SEED='TRUE' # if you want the app to be seeded with MOCK data.
FRONTEND_URL=http://nexus-portal.portfolio.a4r.fr
ALLOWED_ORIGINS=http://localhost:5173,http://nexus-portal.portfolio.a4r.fr

# Advanced. Do not edit if you do not know what these do.

## Postgres (database) configuration
POSTGRES_DB=nexus_portal
POSTGRES_USER=nexus
POSTGRES_PASSWORD=nexus
POSTGRES_HOST=database
POSTGRES_PORT=5433

## Server container file system configuration :
## this is where user files will be stored.
## You can change this before running the project for the first time.
WORKING_DIRECTORY_PATH='nexus-portal-files'
